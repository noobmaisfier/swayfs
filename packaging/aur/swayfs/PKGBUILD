# Maintainer: Alamine Dione <alaminedion@users.noreply.gitlab.com>
#
# swayfs — personal SwayFX fork focused on low RAM/CPU usage.
#
# This package builds *only* swayfs. The heavy dependencies are the official
# Arch packages `scenefx` and `wlroots0.20` (both in [extra]), so no bundled
# or AUR dependency is required.
#
# The source repository is public:
#   https://github.com/noobmaisfier/swayfs
# The release archive is fetched from tag `v<pkgver>`; keep sha256sums in sync
# with `makepkg -g` after (re)tagging.

pkgname=swayfs
pkgver=0.6.swayfs.4
pkgrel=1
pkgdesc="SwayFX fork focused on low RAM/CPU usage (no swaybar/swaybg, fcft instead of pango)"
arch=('x86_64')
url="https://github.com/noobmaisfier/swayfs"
license=('MIT')
_tag="v${pkgver}"

depends=(
  'cairo'
  'fcft'
  'libdrm'
  'libevdev.so'
  'libinput'
  'libjson-c.so'
  'libpcre2-8.so'
  'libpixman-1.so'
  'libudev.so'
  'libwayland-server.so'
  'libxcb'
  'libxkbcommon.so'
  'scenefx'
  'ttf-font'
  'wlroots0.20'
  'xcb-util-wm'
)
makedepends=(
  'git'
  'meson'
  'ninja'
  'pkgconf'
  'scdoc'
  'wayland-protocols'
)
optdepends=(
  'xorg-xwayland: X11 (XWayland) support'
  'xdg-desktop-portal-wlr: xdg-desktop-portal backend'
  'xdg-desktop-portal-gtk: file picker portal'
  'polkit: system privilege control when not using seatd'
  'swaybg: wallpaper tool (no longer bundled in swayfs)'
  'swayidle: idle management daemon'
  'swaylock: screen locker'
  'waybar: highly customizable bar'
)
provides=('sway' 'wayland-compositor')
conflicts=('sway' 'swayfx' 'swayfx-git' 'swayfs-git')
backup=('etc/sway/config')

source=("$pkgname-$pkgver.tar.gz::https://github.com/noobmaisfier/swayfs/archive/refs/tags/$_tag.tar.gz")
sha256sums=('f7e42738071194dd92b747514146d4a71b992c114299162b4546ddc9cd409e06')

# NOTE: GitHub tag archives extract to $pkgname-$pkgver (no 'v' prefix),
# unlike the previous GitLab archives ($pkgname-$_tag).
_srcdir="$pkgname-$pkgver"

build() {
  # Always start from a clean build dir: reusing a dir configured against a
  # previous release archive silently rebuilds the OLD sources (this shipped
  # a 0.6.swayfs.3-1 package containing the 0.6.swayfs.2 binary).
  rm -rf build
  arch-meson "$_srcdir" build -Dwerror=false -Dman-pages=enabled
  meson compile -C build
}

package() {
  DESTDIR="$pkgdir" meson install -C build
  install -Dm644 "$_srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
